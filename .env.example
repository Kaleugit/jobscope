# Copy to .env for local CDK deploys. In CI these come from GitHub Secrets.

# Existing app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TOKEN_SECRET=
MASTER_USERNAME=kaleu

# Discovery (job collection)
# Optional: without it the public API still works, with lower rate limits.
HIMALAYAS_API_KEY=
# Model for the discovery LLM step. Its own model on purpose: free-tier quotas
# are per model and per project, so discovery never eats the demo's quota.
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
# Each call scores a batch of 8 jobs. Max calls per run; the rest stay pending.
DISCOVERY_MAX_LLM_CALLS=15
DISCOVERY_LLM_INTERVAL_MS=10000
# "low" keeps a call to a few seconds; default thinking took 13-25s per job.
DISCOVERY_THINKING_LEVEL=low
