# Copy to .env for local CDK deploys. In CI these come from GitHub Secrets.

# Existing app
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TOKEN_SECRET=
MASTER_USERNAME=kaleu

# Discovery (job collection)
# Optional: without it the public API still works, with lower rate limits.
HIMALAYAS_API_KEY=
# Optional: model for the discovery LLM step; defaults to GEMINI_MODEL.
GEMINI_DISCOVERY_MODEL=
# Max LLM calls per collection run; the rest stay pending for the next run.
DISCOVERY_MAX_LLM_CALLS=60
